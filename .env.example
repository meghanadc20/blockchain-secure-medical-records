# ---------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env. Values below are placeholders only.
# ---------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=5000
# Origin allowed by CORS (frontend is served by Express on the same origin by default)
CORS_ORIGIN=http://localhost:5000

# --- MongoDB Atlas (Phase 2) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (kept separate from the URI so tests can use their own DB)
MONGO_DB_NAME=medical_data_sharing

# --- Authentication (Phase 3) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
# bcrypt cost factor (10–14). Higher is slower and stronger.
BCRYPT_ROUNDS=12

# --- Internal admin account (used ONLY by: npm run seed:admin) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Supabase Storage (Phase 6) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Kept for completeness per TRD; the browser never talks to Supabase directly.
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=medical-records

# --- File encryption (Phase 6) ---
# 32-byte key, hex encoded (64 hex chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=

# --- Blockchain (Phase 8) ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
# Address printed by: npm run deploy:contract
CONTRACT_ADDRESS=
# Ganache TEST account private key used by the backend to register record hashes.
# Never use a real-funds key. Never expose to the frontend.
PRIVATE_KEY=
