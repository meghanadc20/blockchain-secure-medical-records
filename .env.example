# ---------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env. Values below are placeholders only.
# ---------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=5000
# Origin allowed by CORS (frontend is served by Express on the same origin by default)
CORS_ORIGIN=http://localhost:5000

# --- MongoDB Atlas (Phase 2) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (kept separate from the URI so tests can use their own DB)
MONGO_DB_NAME=medical_data_sharing

# --- Authentication (Phase 3) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
# bcrypt cost factor (10–14). Higher is slower and stronger.
BCRYPT_ROUNDS=12

# --- Internal admin account (used ONLY by: npm run seed:admin) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Supabase Storage (Phase 6) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Kept for completeness per TRD; the browser never talks to Supabase directly.
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=medical-records

# --- File encryption (Phase 6) ---
# 32-byte key, hex encoded (64 hex chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=

# --- Blockchain (Phase 8) — LOCAL Ganache test chain (development) ---
# `npm run chain` fills GANACHE_MNEMONIC, BLOCKCHAIN_RPC_URL and CHAIN_ID automatically;
# `npm run chain:deploy` fills PRIVATE_KEY (first test account) and CONTRACT_ADDRESS.
GANACHE_MNEMONIC=
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
# Address printed by: npm run chain:deploy
CONTRACT_ADDRESS=
# Ganache TEST account private key used by the backend to register record hashes.
# Never use a real-funds key. Never expose to the frontend.
PRIVATE_KEY=

# Opt-in: Sepolia TEST ether (max 0.05) sent by the platform wallet to each newly linked
# patient wallet so it can pay fees. Leave empty to disable. Ignored on the local chain.
TESTNET_WALLET_FUNDING_ETH=

# --- Public demo deployment (Render + Sepolia) — see docs/DEPLOYMENT.md ---
# Used ONLY by `npm run chain:sepolia-wallet`, `npm run chain:deploy:sepolia` and
# `npm run render:env` (which writes the git-ignored .env.render for Render).
# Free Alchemy Sepolia URL, e.g. https://eth-sepolia.g.alchemy.com/v2/<your-api-key>  (secret)
SEPOLIA_RPC_URL=
# Dedicated Sepolia TEST wallet created by `npm run chain:sepolia-wallet` (secret, never share)
SEPOLIA_PRIVATE_KEY=
# Filled by `npm run chain:deploy:sepolia`
SEPOLIA_CONTRACT_ADDRESS=
# Separate Atlas database for the demo, so local data is never touched
DEMO_MONGO_DB_NAME=medchain_demo
# Your Render URL, e.g. https://medchain-xxxx.onrender.com (optional, becomes CORS_ORIGIN)
RENDER_URL=
# Production JWT secret, generated automatically by `npm run render:env`
RENDER_JWT_SECRET=
